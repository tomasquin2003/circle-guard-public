def selectedServices = [
    'circleguard-auth-service',
    'circleguard-identity-service',
    'circleguard-promotion-service',
    'circleguard-notification-service',
    'circleguard-form-service',
    'circleguard-gateway-service'
]

def gradleWrapper() {
    return isUnix() ? './gradlew' : 'gradlew.bat'
}

def runCommand(String command) {
    if (isUnix()) {
        sh command
    } else {
        bat command
    }
}

def commandAvailable(String linuxCommand, String windowsCommand) {
    if (isUnix()) {
        return sh(script: linuxCommand, returnStatus: true) == 0
    }

    return bat(script: "@echo off\r\n${windowsCommand}", returnStatus: true) == 0
}

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_TO_K8S',
            defaultValue: false,
            description: 'Si es true ejecuta kubectl apply real contra el kubeconfig del agente. Si es false solo ejecuta dry-run.'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment Info') {
            steps {
                script {
                    runCommand('java --version')
                    runCommand("${gradleWrapper()} --version")
                    runCommand('docker --version')
                    runCommand('kubectl version --client=true')
                }
            }
        }

        stage('Run Unit/Integration Tests') {
            steps {
                script {
                    def testTasks = selectedServices.collect { service ->
                        ":services:${service}:test"
                    }.join(' ')

                    runCommand("${gradleWrapper()} ${testTasks} -PexcludeJUnitTags=performance --console=plain --no-daemon")
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
                }
            }
        }

        stage('Build Boot JARs') {
            steps {
                script {
                    def jarTasks = selectedServices.collect { service ->
                        ":services:${service}:bootJar"
                    }.join(' ')

                    runCommand("${gradleWrapper()} ${jarTasks} --console=plain --no-daemon")
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    selectedServices.each { service ->
                        runCommand("docker build -f Dockerfile.service --build-arg SERVICE_NAME=${service} -t ${service}:stage .")
                    }
                }
            }
        }

        stage('Validate Kubernetes Manifests') {
            steps {
                script {
                    runCommand('kubectl apply --dry-run=client -f k8s/dev/')
                }
            }
        }

        stage('Deploy to Kubernetes Stage') {
            steps {
                script {
                    if (params.DEPLOY_TO_K8S) {
                        echo 'DEPLOY_TO_K8S=true: aplicando manifiestos sobre el cluster configurado en el agente Jenkins.'
                        runCommand('kubectl apply -f k8s/dev/')
                    } else {
                        echo 'DEPLOY_TO_K8S=false: no se ejecuta apply real; se conserva dry-run como evidencia defendible.'
                        runCommand('kubectl apply --dry-run=client -f k8s/dev/')
                    }
                }
            }
        }

        stage('Run E2E Against Stage') {
            steps {
                script {
                    if (isUnix()) {
                        if (commandAvailable('command -v pwsh >/dev/null 2>&1', 'where pwsh >nul 2>nul')) {
                            runCommand('pwsh -ExecutionPolicy Bypass -File e2e/run-e2e.ps1')
                        } else {
                            echo 'Agente Linux sin pwsh: E2E PowerShell no ejecutado. Alternativa documentada en docs/jenkins-stage-master.md.'
                        }
                    } else {
                        runCommand('powershell -ExecutionPolicy Bypass -File e2e/run-e2e.ps1')
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
                archiveArtifacts allowEmptyArchive: true, artifacts: '**/build/test-results/test/*.xml, e2e/results/*.md, performance/locust/results/*.csv, k8s/**/*.yaml'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: '**/build/test-results/test/*.xml, e2e/results/*.md, performance/locust/results/*.csv, k8s/**/*.yaml'
        }
        success {
            echo 'Pipeline stage completado: tests, bootJar, imagenes Docker locales, validacion Kubernetes, deploy parametrizado y E2E preparados.'
        }
        failure {
            echo 'Pipeline stage fallido. Revisar herramienta faltante, kubeconfig, Docker daemon o disponibilidad del entorno E2E.'
        }
    }
}
